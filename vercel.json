{
  "buildCommand": "npm run prebuild && prisma generate && npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "app/**": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/sessions",
      "destination": "http://localhost:8000/api/sessions"
    },
    {
      "source": "/api/sessions/sync-data",
      "destination": "http://localhost:8000/api/sessions/sync-data"
    },
    {
      "source": "/api/sessions/(.*)",
      "destination": "http://localhost:8000/api/sessions/$1"
    },
    {
      "source": "/api/chat/stream",
      "destination": "http://localhost:8000/api/chat/stream"
    },
    {
      "source": "/api/data-extraction",
      "destination": "http://localhost:8000/api/data-extraction"
    },
    {
      "source": "/api/admin/user-data",
      "destination": "http://localhost:8000/api/admin/user-data"
    },
    {
      "source": "/api/admin/stats",
      "destination": "http://localhost:8000/api/admin/stats"
    },
    {
      "source": "/api/admin/feedback",
      "destination": "http://localhost:8000/api/admin/feedback"
    },
    {
      "source": "/api/admin/sessions",
      "destination": "http://localhost:8000/api/admin/sessions"
    },
    {
      "source": "/api/feedback",
      "destination": "http://localhost:8000/api/feedback"
    },
    {
      "source": "/api/messages/(.*)",
      "destination": "http://localhost:8000/api/messages/$1"
    },
    {
      "source": "/api/health",
      "destination": "http://localhost:8000/api/health"
    }
  ]
}